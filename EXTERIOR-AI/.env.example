# Copy this file to .env and fill in real values.
# Nothing in this app will actually call AI/email services until these are set.

# Required for real AI detection (Claude vision) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required for real AI render (Replicate FLUX Kontext Pro) — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional — lead notification emails via Resend (https://resend.com/api-keys).
# Without these, leads are still saved to data/leads.jsonl, you just won't get an email.
RESEND_API_KEY=

# Where new-lead emails are sent. REQUIRED for notifications to work — if this
# is empty the email is skipped and logged, never sent to the homeowner instead.
LEAD_NOTIFY_EMAIL=

# The address in the privacy notice, shown to anyone whose withdrawal link has
# expired. Must match what the notice says. Falls back to LEAD_NOTIFY_EMAIL.
PRIVACY_EMAIL=

# Who new-lead emails come from. Defaults to Resend's test sender
# (onboarding@resend.dev), which ONLY delivers to your own Resend account
# address — fine for testing, useless in production. Verify a domain at
# https://resend.com/domains and use an address on it, e.g.
#   LEAD_FROM_EMAIL=Facet Pro <leads@facetpro.co.uk>
LEAD_FROM_EMAIL=

# The homeowner's own copy of their design: before/after, their choices, the
# itemised estimate, the planning-estimate caveat and how to withdraw consent.
# Sends automatically once RESEND_API_KEY is set AND LEAD_FROM_EMAIL is on a
# domain you've verified — it is refused on Resend's test sender, which can
# only reach your own account. The site asks the server (GET /api/config)
# whether this is on, so the form never promises an email that won't arrive.
# Set to `off` to disable it even when email is otherwise configured.
DESIGN_PACK_EMAIL=

# Absolute base URL used for links inside emails (privacy notice, terms).
SITE_URL=https://facetpro.co.uk

# Optional — fire-and-forget POST of every lead to a CRM webhook (Zapier, HubSpot, Make, etc.)
CRM_WEBHOOK_URL=

# Global daily caps on the paid endpoints, counted per UTC day across all
# callers. Once a cap is hit the endpoint returns 429 without calling Anthropic
# or Replicate, so these bound your bill. Set to 0 to disable an endpoint.
DAILY_DETECT_LIMIT=50
DAILY_RENDER_LIMIT=50

# "Measure my walls" tuning (measure.js). Defaults come from the prototype
# survey table and are only used by the coverage fallback, i.e. when no front
# door was detected to scale against. Override per house type to fold in your
# own surveyed properties. Anything invalid is ignored with a warning.
#
# Calibration factor: estimated m² = coverage × factor
WALL_CALIBRATION_TERRACE=277
WALL_CALIBRATION_SEMI=303
WALL_CALIBRATION_DETACHED=342
#
# Expected wall coverage of a well-framed photo, per house type. A photo
# outside centre ± tolerance is treated as badly framed and the estimate
# falls back to the house-type prior.
WALL_COVERAGE_TERRACE=0.18
WALL_COVERAGE_SEMI=0.28
WALL_COVERAGE_DETACHED=0.38
WALL_COVERAGE_ENDTERRACE=0.18
WALL_COVERAGE_TOLERANCE=0.04
#
# Front elevation -> whole-house wall area. Derived from plan geometry
# (exposed perimeter / frontage width), not measured against real properties.
# Run `npm run validate` with surveyed samples and update these from what it
# reports. Mid-terrace is exactly 2.0 by geometry — front and rear only.
WALL_FRONT_TO_TOTAL_TERRACE=2.00
WALL_FRONT_TO_TOTAL_SEMI=3.05
WALL_FRONT_TO_TOTAL_ENDTERRACE=3.45
WALL_FRONT_TO_TOTAL_DETACHED=3.84

# Required to use the installer area. GET /api/leads returns homeowner names,
# emails, phone numbers and postcodes, so it is refused entirely unless this is
# set. Use a long random value, e.g. `openssl rand -base64 24`.
INSTALLER_PASSWORD=

PORT=3020

# Site mode. Defaults to `beta`, which shows a badge in the header, a notice
# above the hero and a line in the footer explaining that the measurement is
# still being calibrated. Set to `live` to remove them — that way forgetting
# to change it leaves the honest label up rather than taking it down.
SITE_MODE=beta

# Lead capture. The code defaults to `on`, but this template ships `off`,
# because copying a template and forgetting a line should not be how you start
# collecting people's names and addresses.
#
# Turn it on when the privacy notice has no [PLACEHOLDERS] left in it, the ICO
# registration is done, and DATABASE_URL is set. The rest of the journey
# (photo, colours, estimate, render) works either way, and the form is replaced
# with an honest explanation rather than being disabled.
LEAD_CAPTURE=off

# Lead delivery. Each lead is POSTed to every recipient here, with retries, and
# the outcome per recipient is recorded for billing (GET /api/deliveries,
# behind INSTALLER_PASSWORD). URLs must be https — lead data must not travel in
# clear. A malformed value delivers to nobody and says so at startup.
#
# LEAD_RECIPIENTS=[{"id":"anglian","name":"Anglian","url":"https://...","headers":{"X-Api-Key":"..."}},{"id":"zenith","name":"Zenith","url":"https://..."}]
LEAD_RECIPIENTS=

# Optional "areas" per recipient: postcode areas ("SW") or full outward codes
# ("SW11"). A recipient with no areas covers everywhere, which is what a
# national buyer looks like — get that claim in writing, because code cannot
# check it. A lead with no usable postcode only ever reaches national buyers.
# LEAD_RECIPIENTS=[{"id":"north","name":"Northern Co","url":"https://...","areas":["M","LS","BD"]}]

# How many installers one lead may go to. The consent wording on the form says
# "up to three", and that sentence is the limit: this can lower it, not raise
# it. Set to 0 to stop sharing entirely without unconfiguring the buyers.
MAX_INSTALLERS_PER_LEAD=3

# Replicate's content filter, 0 (strictest) to 6 (most permissive). 2 is
# Replicate's default and the highest their API accepts for image-to-image.
# Raise it only if legitimate photographs of houses start being refused.
RENDER_SAFETY_TOLERANCE=2

# Postgres. Set this and leads, delivery records and notification failures are
# stored in the database instead of JSONL files — which is what makes the
# privacy notice's "stored encrypted" and "backed up" claims true, and removes
# the need for a mounted volume.
#
# Tables go in their own schema (default facetpro_visualiser), never public:
# the obvious database to point this at already belongs to the FastAPI backend
# and shares seven of our table names with entirely different columns.
DATABASE_URL=
DB_SCHEMA=facetpro_visualiser
